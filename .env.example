# ==========================================
# CLIENT-SIDE (Visible in Browser)
# ==========================================

# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ntfy notifications (client): topic that receives new-client & order cards
VITE_NTFY_TOPIC=ARBAREA
# VITE_NTFY_URL=https://ntfy.sh

# Canonical origin used by canonical links and the social share card (OG tags).
# Must be a host that actually resolves — VK/Telegram fetch og-image.jpg from it.
# Defaults to the Vercel domain; set this once arbarea.ru is connected.
# VITE_SITE_URL=https://arbarea.ru

# ==========================================
# SERVER-SIDE (Vercel Functions / Node.js)
# Secrets! Do NOT commit to Git.
# ==========================================

# Supabase Admin (Required for Payments/Admin API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Telegram Notifications
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_CHAT_ID=-100...

# ntfy notifications (server, payment webhook). Defaults to ntfy.sh/ARBAREA.
NTFY_TOPIC=ARBAREA
# NTFY_URL=https://ntfy.sh

# Tinkoff Payments (T-Bank)
TINKOFF_TERMINAL_KEY=1234567890DEMO
TINKOFF_PASSWORD=your_secret_password

# AI Agents (Optional)
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
